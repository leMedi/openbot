{
  "name": "@openbot/agent-evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "eval": "dotenv -e ../../.env -- promptfoo eval -c promptfooconfig.yaml --no-cache",
    "eval:view": "promptfoo view",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openbot/agent": "workspace:*",
    "@openbot/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "dotenv-cli": "11.0.0",
    "promptfoo": "^0.122.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
