OPENBOT_DATA_DIR=.data
OPENBOT_PUBLIC_URL=http://localhost:3000
# Optional desktop mode: per-agent (default) or disabled.
OPENBOT_DESKTOP_MODE=per-agent
# Optional local executable implementing docs/desktop-driver.md.
OPENBOT_DESKTOP_DRIVER=
OPENBOT_DESKTOP_DRIVER_ARGS=[]
OPENBOT_COMPUTER_TIMEOUT_MS=120000
# Required in per-agent mode to provision an X display when creating an agent.
OPENBOT_START_WINDOW=
# Optional executable used by the server's automatic update action.
OPENBOT_UPDATE_COMMAND=
